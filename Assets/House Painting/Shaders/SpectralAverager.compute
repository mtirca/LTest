#pragma kernel SpectralAverager

Texture2DArray<float> MaskTex;
Texture2DArray<float> MSTex;

RWStructuredBuffer<float> OutputSignatures;
RWStructuredBuffer<int> ResultCounter;

int _SliceIndex;
int _TotalBands;
int _MaxExpectedPixels;

[numthreads(8, 8, 1)]
void SpectralAverager (uint3 id : SV_DispatchThreadID)
{
    // Safety check: Ensure we don't read outside the texture bounds
    uint width, height, elements;
    MaskTex.GetDimensions(width, height, elements);
    if (id.x >= width || id.y >= height || _SliceIndex < 0 || _SliceIndex >= (int)elements)
    {
        return;
    }
    
    // Is this pixel painted on this specific label's slice?
    if (MaskTex[uint3(id.xy, _SliceIndex)] > 0.0)
    {
        int index;
        InterlockedAdd(ResultCounter[0], 1, index);
        
        // Optional safety clamp
        if (index < _MaxExpectedPixels)
        {
            for(int b = 0; b < _TotalBands; b++)
            {
                OutputSignatures[index * _TotalBands + b] = MSTex[uint3(id.xy, b)];
            }
        }
    }
}